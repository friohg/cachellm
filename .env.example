# ---------------------------------------------------------------------------
# CacheLLM configuration (copy to .env and edit)
# Every value here can also live in cachellm.config.json; environment wins.
# ---------------------------------------------------------------------------

# --- proxy ---------------------------------------------------------------
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=INFO

# --- upstream provider (any OpenAI-compatible API) -----------------------
# Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://localhost:11434/v1        (Ollama)
#   http://localhost:8000/v1         (vLLM / llama.cpp / LM Studio)
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_PROVIDER=openai_compatible
# true = forward each client's own Authorization header instead of the key above
FORWARD_CLIENT_KEY=false

# --- cache ---------------------------------------------------------------
CACHE_BACKEND=sqlite
SQLITE_PATH=./data/cache.db
# REDIS_URL=redis://127.0.0.1:6379/0
DEFAULT_TTL=3600
CACHE_NAMESPACE=default
CACHE_ENABLED=true
CACHE_FAIL_OPEN=true
CACHE_STREAMING=true

# Agent frameworks (Hermes Agent, LangChain, OpenAI Agents SDK, ...) attach their
# whole toolset - terminal, write_file, delete_* - to every call, so the default
# conservative rule leaves their biggest request permanently uncached.
# true caches the model's tool-call DECISION for an identical context; replaying a
# hit executes nothing, and the tool-result cache still refuses mutations always.
CACHE_RESPONSES_WITH_TOOLS=false
AGENT_TOOL_CALL_TTL=300

# --- semantic cache (opt-in) --------------------------------------------
SEMANTIC_CACHE=false
SEMANTIC_THRESHOLD=0.92
# hash = offline, no downloads; sentence_transformers = real local model
SEMANTIC_BACKEND=hash
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBED_BASE_URL=
# EMBED_API_KEY=

# --- concurrency ---------------------------------------------------------
SINGLE_FLIGHT=true

# --- privacy -------------------------------------------------------------
STORE_PROMPTS=true
STORE_RESPONSES=true
STORE_TOOL_ARGUMENTS=true
STORE_TOOL_RESULTS=true
RETENTION_DAYS=30

# --- observability -------------------------------------------------------
DASHBOARD_ENABLED=true
TOKEN_ESTIMATOR=heuristic
